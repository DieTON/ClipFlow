FROM node:18-alpine\n\nWORKDIR /app\n\n# Install FFmpeg and other dependencies\nRUN apk add --no-cache ffmpeg python3 make g++\n\n# Copy package files\nCOPY package*.json ./\nRUN npm ci --only=production\n\n# Copy source\nCOPY src ./src\nCOPY tsconfig.json ./\nCOPY prisma ./prisma\n\n# Build\nRUN npm run build\n\n# Create logs and videos directories\nRUN mkdir -p logs videos\n\nEXPOSE 5000\n\nCMD [\"npm\", \"start\"]\n